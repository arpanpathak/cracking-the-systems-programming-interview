digraph sys {
  rankdir=LR; nodesep=0.3; ranksep=0.5;
  node [fontsize=10 shape=box];
  subgraph cluster_user { label="your process (user space)"; style="rounded"; color="#2f7f86"; fontname="Helvetica";
    code [label="fs::read_to_string(\"hello.txt\")" fontname="Menlo" fillcolor="#e3f1ea"];
    fdt [label="file descriptor 3\n(a small number that\nnames the open file)" fontname="Helvetica"]; }
  subgraph cluster_kernel { label="operating system kernel"; style="rounded"; color="#c89b3c"; fontname="Helvetica";
    sc [label="system calls:\nopen, read, close" fillcolor="#fdf6e8"];
    pc [label="page cache\n(recently used file data\nkept in memory)"]; }
  disk [label="disk" shape=cylinder fillcolor="#eef3f7"];
  code -> sc [label=" 1. request"]; sc -> pc [label=" 2. look up"]; pc -> disk [label=" 3. read if not cached" style=dashed];
  sc -> fdt [label=" open returns" constraint=false style=dotted];
  pc -> code [label=" 4. bytes copied into\n your buffer" color="#2f7f86" constraint=false];
}
