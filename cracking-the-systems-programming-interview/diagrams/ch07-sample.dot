digraph sample {
  rankdir=LR; nodesep=0.5;
  node [shape=circle fixedsize=true width=0.6 fontname="Menlo"];
  A [label="A\n0" fillcolor="#fdf6e8"]; B [label="B\n1"]; C [label="C\n3"]; D [label="D\n4" fillcolor="#e3f1ea"];
  A -> B [label="1" color="#2f7f86" penwidth=2.2 fontcolor="#2f7f86"];
  A -> C [label="4"];
  B -> C [label="2" color="#2f7f86" penwidth=2.2 fontcolor="#2f7f86"];
  B -> D [label="5"];
  C -> D [label="1" color="#2f7f86" penwidth=2.2 fontcolor="#2f7f86"];
  vec [shape=record fixedsize=false width=0 fontsize=10 label="{index form: Vec&lt;Vec&lt;(usize, u32)&gt;&gt;|0: [(1,1), (2,4)]\l1: [(2,2), (3,5)]\l2: [(3,1)]\l3: []\l}" fillcolor="#ffffff"];
  D -> vec [style=invis];
}
