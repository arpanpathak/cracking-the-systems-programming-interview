graph kruskal {
  layout=neato; overlap=false; splines=true;
  node [shape=circle fixedsize=true width=0.45 fontname="Menlo"];
  n0 [label="0" pos="0,1!"]; n1 [label="1" pos="1.6,2!"]; n2 [label="2" pos="1.6,0!"]; n3 [label="3" pos="3.2,1!"]; n4 [label="4" pos="4.8,1!"];
  edge [fontname="Menlo" fontsize=10];
  n1 -- n2 [label="1" color="#2f7f86" penwidth=3];
  n1 -- n3 [label="2" color="#2f7f86" penwidth=3];
  n3 -- n4 [label="2" color="#2f7f86" penwidth=3];
  n0 -- n2 [label="3" color="#2f7f86" penwidth=3];
  n0 -- n1 [label="4" style=dashed color="#aebccb"];
  n2 -- n3 [label="4" style=dashed color="#aebccb"];
}
