digraph workload {
  rankdir=LR;
  node [shape=box];
  Pending [fillcolor="#fdf1e4"];
  Terminated [fillcolor="#e3f1ea" peripheries=2];
  Failed [fillcolor="#fbe3d6" peripheries=2];
  Pending -> Provisioning;
  Provisioning -> Running;
  Running -> Terminating;
  Terminating -> Terminated;
  Pending -> Failed [color="#d9622b"];
  Provisioning -> Failed [color="#d9622b"];
  Running -> Failed [color="#d9622b"];
  Terminating -> Failed [color="#d9622b"];
  Failed -> Pending [style=dashed label=" retry" fontcolor="#2f7f86" color="#2f7f86"];
  Failed -> Provisioning [style=dashed label=" retry" fontcolor="#2f7f86" color="#2f7f86"];
  {rank=same; Terminated; Failed}
}
