digraph jobs {
  rankdir=LR; nodesep=0.1;
  node [shape=record fontname="Menlo" fontsize=10];
  t [label="time|1|2|3|4|5|6" style="filled" fillcolor="#ffffff" color="#aebccb"];
  j1 [label="{job A  [1,3)  profit 50}" fillcolor="#e3f1ea"];
  j2 [label="{job B  [2,4)  profit 10}"];
  j3 [label="{job C  [3,5)  profit 40}"];
  j4 [label="{job D  [3,6)  profit 70}" fillcolor="#e3f1ea"];
  t -> j1 [style=invis]; j1 -> j4 [label=" A ends at 3 = D starts:\n compatible, 50 + 70 = 120" color="#2f7f86" fontcolor="#2f7f86"];
}
